# Copy to .env next to docker-compose.yml and edit. docs/self-host.md explains each setting.
# Keep this file private (chmod 600 .env): it names your backup target.
# Never put a cloud key file or a password here; use the host's service account or role.

# The public DNS name of this host (or its static IP address, which gets a short-lived
# certificate); the binary obtains and renews a Let's Encrypt certificate for it. Port 443 of the
# host must reach this container. Set this OR AWM_BEHIND_TLS_PROXY, never both.
AWM_DOMAIN=awm.example.com

# Where backups go: gs://BUCKET/PREFIX, s3://BUCKET/PREFIX or file:///data/backup (a second disk
# mounted into the container is better than the same volume). Empty means NO BACKUP: a disk loss
# destroys membership, invites and key wraps. See docs/self-host.md#backup.
AWM_BACKUP=

# Set to 1 when your own TLS proxy (Caddy, nginx, a load balancer) terminates TLS in front of
# this container; leave AWM_DOMAIN empty then and publish 8443 to the proxy only.
AWM_BEHIND_TLS_PROXY=

# Required with AWM_BEHIND_TLS_PROXY: comma-separated CIDR ranges of the proxy, whose
# X-Forwarded-For header is believed, for example 172.18.0.0/16.
AWM_TRUSTED_PROXY=

# Optional contact address for the Let's Encrypt account (expiry notices).
AWM_ACME_EMAIL=

# tls-alpn-01 (default; needs only port 443) or http-01 (also set AWM_ACME_HTTP_LISTEN=0.0.0.0:8080
# and publish 80:8080 in docker-compose.yml).
AWM_ACME_CHALLENGE=
AWM_ACME_HTTP_LISTEN=

# Optional: a different image, for example a pinned release tag.
# AWM_IMAGE=ghcr.io/asugawara/agent-web-memory:v0.2.0
