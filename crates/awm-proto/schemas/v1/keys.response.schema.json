{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awm.invalid/schemas/v1/keys.response.schema.json",
  "title": "GET /v1/keys response",
  "type": "object",
  "properties": {
    "current_epoch": {
      "$ref": "common.schema.json#/$defs/u32"
    },
    "rotation_needed": {
      "type": "boolean"
    },
    "wraps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "epoch": {
            "$ref": "common.schema.json#/$defs/u32"
          },
          "wrap": {
            "$ref": "common.schema.json#/$defs/epoch_wrap_bytes"
          },
          "auth": {
            "$ref": "common.schema.json#/$defs/key32"
          },
          "created_by": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "auth",
          "created_by",
          "epoch",
          "wrap"
        ]
      }
    }
  },
  "required": [
    "current_epoch",
    "rotation_needed",
    "wraps"
  ]
}
