{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awm.invalid/schemas/v1/common.schema.json",
  "title": "Shared definitions of sync protocol v1",
  "$defs": {
    "id": {
      "description": "UUID, canonical: lower-case, hyphenated",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,24}$"
    },
    "tag": {
      "description": "rec, flag, stats, policy, roster; later tags in the same form",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,15}$"
    },
    "head": {
      "description": "highest index of a stream, -1 when empty",
      "type": "integer",
      "minimum": -1
    },
    "idx": {
      "type": "integer",
      "minimum": 0
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "time": {
      "description": "Unix seconds",
      "type": "integer",
      "minimum": 0
    },
    "hour": {
      "description": "Unix seconds rounded down to the hour",
      "type": "integer",
      "minimum": 0,
      "multipleOf": 3600
    },
    "b64": {
      "description": "unpadded base64url",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "key32": {
      "description": "32 bytes, unpadded base64url",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "blob": {
      "description": "record envelope v1, unpadded base64url: 297 to 16384 bytes",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "minLength": 396,
      "maxLength": 21846
    },
    "device_token": {
      "type": "string",
      "pattern": "^awm_t_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "invite_token": {
      "type": "string",
      "pattern": "^awm_i_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "bootstrap_token": {
      "type": "string",
      "pattern": "^awm_b_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})(-[0-9A-Za-z.-]{1,32})?$"
    },
    "role": {
      "enum": [
        "member",
        "admin"
      ]
    },
    "invite_kind": {
      "enum": [
        "member",
        "device"
      ]
    },
    "epoch_wrap_bytes": {
      "description": "a wrapped epoch key (TM3 fixes the layout)",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    }
  }
}
