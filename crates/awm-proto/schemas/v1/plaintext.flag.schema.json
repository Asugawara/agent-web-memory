{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awm.invalid/schemas/v1/plaintext.flag.schema.json",
  "title": "Plaintext of a flag record, schema 1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "a reader skips a higher schema (it decodes as Newer)"
    },
    "record_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "reason": {
      "enum": [
        "quarantine",
        "user"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 200
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/time"
    }
  },
  "required": [
    "created_at",
    "reason",
    "record_id",
    "schema"
  ]
}
