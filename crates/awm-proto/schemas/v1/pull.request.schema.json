{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awm.invalid/schemas/v1/pull.request.schema.json",
  "title": "POST /v1/pull request",
  "type": "object",
  "properties": {
    "cursors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "device": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "tag": {
            "$ref": "common.schema.json#/$defs/tag"
          },
          "from": {
            "$ref": "common.schema.json#/$defs/idx"
          }
        },
        "required": [
          "device",
          "from",
          "member",
          "tag"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "cursors",
    "limit"
  ],
  "additionalProperties": false
}
